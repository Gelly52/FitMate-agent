# =============================================
# FitMate-AI local development environment
# Copy this file to .env and adjust values if needed.
# =============================================

# MySQL
DB_HOST=127.0.0.1
DB_PORT=5506
DB_NAME=fitmate
DB_USERNAME=root
DB_PASSWORD=123456

# Redis Stack
REDIS_HOST=127.0.0.1
REDIS_PORT=9379
REDIS_PASSWORD=123456

# Mail SMTP (password 为授权码而非登录密码)
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your_email@163.com
MAIL_PASSWORD=your_mail_auth_code

# MCP services
MCP_SERVER_PORT=9070
MCP_CLIENT_PORT=7070
MCP_SERVER_URL=http://localhost:9070

# Frontend allowed origins
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# SearXNG. Started by default with: docker compose up -d
SEARXNG_PORT=6080
SEARXNG_URL=http://127.0.0.1:6080/search
SEARXNG_COUNTS=25
SEARXNG_BASE_URL=http://127.0.0.1:6080/

# Optional API keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# RAG embedding
RAG_EMBEDDING_PROVIDER=bge-m3-http
EMBEDDING_SERVICE_URL=http://127.0.0.1:7086
RAG_VECTOR_INDEX_NAME=fitmate-vectorstore-bgem3
RAG_VECTOR_PREFIX=fitmate:dev:rag:embedding:bgem3:
RAG_KEYWORD_INDEX_NAME=fitmate-keyword-index
RAG_KEYWORD_KEY_PREFIX=fitmate:dev:rag:chunk:
