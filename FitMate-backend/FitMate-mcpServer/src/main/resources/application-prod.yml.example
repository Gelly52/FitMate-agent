# =============================================================================
# FitMate-MCP-Server 生产环境配置模板
# 使用方法：复制为 application-prod.yml，填入真实生产值
#   cp application-prod.yml.example application-prod.yml
#   vim application-prod.yml
# 注意：application-prod.yml 已被 .gitignore 排除，不会进入仓库
# =============================================================================

# Server
server:
  port: ${MCP_SERVER_PORT:9070}

# Spring
spring:
  datasource:
    type: com.zaxxer.hikari.HikariDataSource
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://${DB_HOST:127.0.0.1}:${DB_PORT:3306}/${DB_NAME:fitmate}?useUnicode=true&characterEncoding=UTF-8&autoReconnect=true&useSSL=true&serverTimezone=Asia/Shanghai
    username: ${DB_USERNAME:fitmate}
    password: ${DB_PASSWORD:your_strong_production_db_password}
    hikari:
      pool-name: FitMateMcpServerHikariCP
      connection-timeout: 30000
      minimum-idle: 5
      maximum-pool-size: 20
      auto-commit: true
      idle-timeout: 600000
      max-lifetime: 18000000
      connection-test-query: SELECT 1
  mail:
    host: ${MAIL_HOST:smtp.163.com}
    port: ${MAIL_PORT:465}
    username: ${MAIL_USERNAME:your_email@163.com}
    password: ${MAIL_PASSWORD:your_mail_auth_code}
    protocol: smtp
    default-encoding: UTF-8
    properties:
      mail:
        smtp:
          socketFactory:
            port: ${MAIL_PORT:465}
            class: javax.net.ssl.SSLSocketFactory
          ssl:
            enable: true
